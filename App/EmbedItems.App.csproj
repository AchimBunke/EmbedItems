<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>EmbedItems</AssemblyName>
        <RootNamespace>EmbedItems.App</RootNamespace>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
        <!-- Local builds are 0.0.0 (no update check comparison); release.yml sets the tag's version with -p:Version. -->
        <Version>0.0.0</Version>
        <!-- Folder scans parse many maps in parallel and allocate large buffers; with the default GC all threads
             wait on one collector (1050 maps: 23.6 s vs 10.5 s with server GC). -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <!-- Release: one self-contained, compressed exe. WinForms can't be trimmed, so this one is bigger than the CLI. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\EmbedItems.Core.csproj" />
    </ItemGroup>

</Project>

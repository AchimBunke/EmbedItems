<Project Sdk="Microsoft.NET.Sdk">

    <!-- All embedding logic. The UI (App) and the command line (Cli) are thin front ends over this. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GBX.NET" Version="2.5.1" />
        <PackageReference Include="GBX.NET.LZO" Version="2.1.6" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EmbedItems.Tests" />
    </ItemGroup>

</Project>
